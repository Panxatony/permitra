# Vorlage für die Konfiguration – als .env kopieren und ausfüllen.
#   cp .env.example .env
# Die .env ist per .gitignore ausgeschlossen und gehört nie ins Repository.

# --- Pflicht -----------------------------------------------------------------
# Ohne diese Werte startet der Stack bewusst nicht (fail-secure). Ein bekannter
# Standardwert würde fälschbare Admin-Tokens erlauben.
#   openssl rand -hex 32
SECRET_KEY=
#   openssl rand -hex 24
# Achtung: wird nur bei der ERSTEN Initialisierung des Postgres-Volumes gesetzt.
# Bei einem bestehenden Volume muss der Wert zum dort angelegten Passwort passen.
DB_PASSWORD=

# --- Demo-Betrieb ------------------------------------------------------------
# Legt die bekannten Demo-Konten an (admin/admin123 usw.).
# In Produktion NICHT setzen – dann wird ein Erst-Admin mit Zufallspasswort
# angelegt und einmalig ins Log geschrieben.
PERMITRA_DEMO=

# --- E-Mail (leer = Versand aus) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Basis-URL für Links in E-Mails, z.B. https://permitra.example.org
PERMITRA_BASE_URL=

# --- Passkeys / WebAuthn (Default: aus PERMITRA_BASE_URL abgeleitet) ---------
PERMITRA_RP_ID=
PERMITRA_ORIGIN=

# --- Sicherheit --------------------------------------------------------------
# Kommagetrennte IPs/CIDRs eines vorgelagerten Reverse-Proxys. Nur von diesen
# Adressen wird X-Forwarded-For ausgewertet. Die Quell-IP landet im Audit-Log –
# ohne diese Einschränkung könnte jeder Client seine Herkunft frei erfinden.
# Leer lassen, wenn der Container direkt veröffentlicht ist. Wichtig: Der
# veröffentlichte Port muss dann so gebunden sein, dass ihn nur der Proxy
# erreicht (z.B. FRONTEND_PORT=127.0.0.1:8100).
PERMITRA_TRUSTED_PROXIES=
# Erlaubte Frontend-Origins, kommagetrennt. "*" wird bewusst abgelehnt.
PERMITRA_CORS_ORIGINS=

# --- Change-Management-Webhook (z.B. ServiceNow) -----------------------------
CHANGE_WEBHOOK_URL=
CHANGE_WEBHOOK_TOKEN=

# --- SIEM-Anbindung des Audit-Logs (leer = aus) ------------------------------
# Ist ein Ziel gesetzt, werden Ereignisse dauerhaft vorgemerkt und zuverlässig
# zugestellt (at-least-once), auch über Neustarts und Ausfälle hinweg.
AUDIT_WEBHOOK_URL=
AUDIT_SYSLOG_HOST=
AUDIT_SYSLOG_PORT=514
# udp = best effort, tcp = quittiert (RFC 6587)
AUDIT_SYSLOG_PROTO=udp
# Abstand zwischen zwei Verankerungen des Audit-Ketten-Endes in Sekunden.
# Ein Prüfpunkt begrenzt, wie viele der jüngsten Einträge unbemerkt entfernt
# werden könnten – kürzer = engmaschiger.
AUDIT_CHECKPOINT_INTERVAL=3600
