# Configuration template – copy to .env and fill in.
#   cp .env.example .env
# The .env file is excluded via .gitignore and never belongs in the repository.

# --- Required ----------------------------------------------------------------
# Without these values the stack deliberately refuses to start (fail-secure).
# A well-known default value would allow forgeable admin tokens.
#   openssl rand -hex 32
SECRET_KEY=
#   openssl rand -hex 24
# Note: this is only applied on the FIRST initialization of the Postgres volume.
# With an existing volume the value must match the password created there.
DB_PASSWORD=

# --- Demo operation ----------------------------------------------------------
# Creates the well-known demo accounts (admin/admin123 etc.).
# Do NOT set this in production – an initial admin with a random password is
# created instead and written to the log once.
PERMITRA_DEMO=

# --- Email (empty = delivery off) --------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Base URL for links in emails, e.g. https://permitra.example.org
PERMITRA_BASE_URL=

# --- Imprint and privacy policy (§ 5 DDG, Art. 13 DSGVO) ---------------------
# Absolute http(s) URLs to YOUR OWN legal pages. Leave empty and the footer
# shows no legal links - correct for an instance reachable only inside a
# company network. An instance reachable from the internet must set them, and
# must point them at its own operator's pages: the operator of an instance is
# the one named in the imprint, which is never the supplier of the software.
PERMITRA_IMPRINT_URL=
PERMITRA_PRIVACY_URL=

# --- Passkeys / WebAuthn (default: derived from PERMITRA_BASE_URL) -----------
PERMITRA_RP_ID=
PERMITRA_ORIGIN=

# --- Security ----------------------------------------------------------------
# Comma-separated IPs/CIDRs of an upstream reverse proxy. X-Forwarded-For is
# only evaluated from these addresses. The source IP ends up in the audit log –
# without this restriction any client could make up its own origin.
# Leave empty if the container is published directly. Important: the published
# port must then be bound so that only the proxy can reach it
# (e.g. FRONTEND_PORT=127.0.0.1:8100).
PERMITRA_TRUSTED_PROXIES=

# Rate limit on the sign-in (nginx syntax), default 60r/m with a burst of 20.
# Raise it when many users share one source address (corporate NAT, or a
# reverse proxy that is not listed above) - the limit then applies to all of
# them together. "off" disables it; the per-account lockout stays either way.
PERMITRA_LOGIN_RATE=
# Allowed frontend origins, comma-separated. "*" is deliberately rejected.
PERMITRA_CORS_ORIGINS=

# --- Change management webhook (e.g. ServiceNow) -----------------------------
CHANGE_WEBHOOK_URL=
CHANGE_WEBHOOK_TOKEN=

# --- SIEM connection for the audit log (empty = off) -------------------------
# If a target is set, events are queued persistently and delivered reliably
# (at-least-once), even across restarts and outages.
AUDIT_WEBHOOK_URL=
AUDIT_SYSLOG_HOST=
AUDIT_SYSLOG_PORT=514
# udp = best effort, tcp = acknowledged (RFC 6587)
AUDIT_SYSLOG_PROTO=udp
# Interval between two anchorings of the audit chain end, in seconds.
# A checkpoint limits how many of the most recent entries could be removed
# unnoticed – shorter = tighter.
AUDIT_CHECKPOINT_INTERVAL=3600
